[Unit]
Description=DEBTUPD sandbox forms handler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/imon/projects/debtupd-sandbox/source
EnvironmentFile=/srv/imon/projects/debtupd-sandbox/env/forms.env
ExecStart=/srv/imon/projects/debt-2026-lite/toolchain/node-v22/bin/node server/forms-telegram.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
