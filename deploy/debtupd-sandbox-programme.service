[Unit]
Description=DEBT TECH sandbox programme editor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/imon/projects/debtupd-sandbox/source
EnvironmentFile=/srv/imon/projects/debtupd-sandbox/env/programme-admin.env
ExecStart=/srv/imon/projects/debt-2026-lite/toolchain/node-v22/bin/node server/programme-admin.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/imon/projects/debtupd-sandbox/data

[Install]
WantedBy=multi-user.target
